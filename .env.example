# ---------------------------------------------------------------
# Voyage CRM — self-hosted environment (root .env)
# Copy to `.env` and fill in real values before `docker compose up`.
# ---------------------------------------------------------------

# Public port the nginx frontend container binds to on the host.
HTTP_PORT=80

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap admin — created on first backend startup. Rotate after first login.
ADMIN_EMAIL=admin@voyageCRM.com
ADMIN_PASSWORD=Admin@123

# CORS
# "*" allows all origins (uses regex to keep credentials working).
# Or a comma-separated list: "https://crm.example.com,https://staging.example.com"
CORS_ORIGINS=*
FRONTEND_URL=http://localhost

# ------------------------------
# AI Copilot (Anthropic Claude)
# ------------------------------
# Get one at https://console.anthropic.com — pick "claude-sonnet-4-5-20250929" or newer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ------------------------------
# Email (Resend)
# ------------------------------
# Get one at https://resend.com. Verify a sending domain in production.
RESEND_API_KEY=
RESEND_FROM=Voyage CRM <onboarding@resend.dev>
EMAIL_FROM_NAME=Voyage CRM

# ------------------------------
# Frontend build
# ------------------------------
# Leave EMPTY when frontend + backend share the same origin (nginx routes /api → backend).
# Set to e.g. "https://api.example.com" only if backend is on a different domain.
REACT_APP_BACKEND_URL=
